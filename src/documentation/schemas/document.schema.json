{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Frontmatter of every document except decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "order",
    "status",
    "related"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
