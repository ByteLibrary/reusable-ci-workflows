{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Frontmatter of every decision (ADR).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "status",
    "date",
    "related"
  ],
  "properties": {
    "title": {
      "type": "string",
      "pattern": "^ADR-[0-9]{4}: .+$"
    },
    "status": {
      "type": "string",
      "description": "One of the handbook's statuses for this kind (data/document-statuses.yaml), checked by the rules."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
